[Unit]
Description=Torana security scan of local repositories
Documentation=https://github.com/Torana-Inc/torana-skills/tree/main/scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=torana
Group=torana
# ⛔ flock -n, so a sweep slower than the interval SKIPS rather than piling up.
# Overlapping scans of the same repository race each other's ingests, and the
# server's recency guard would refuse the loser — wasting the whole run.
#
# ⚠️ `-E 75` and SuccessExitStatus below exist because a SKIP IS NOT A FAILURE.
# Plain `flock -n` exits 1 on conflict, which is indistinguishable from the script's
# own exit 1 (an unreadable config, or neither TORANA_ROOT nor TORANA_REPOS set) — and
# MEASURED: the journal showed only "status=1/FAILURE" with no message, so a healthy
# skipped run left a failed unit in `systemctl --failed` looking like a broken scanner.
# 75 (EX_TEMPFAIL) is distinct, logged with a reason, and counted as success.
ExecStart=/bin/sh -c 'flock -n -E 75 /run/lock/torana-scan.lock /opt/torana/torana-scan.sh; rc=$$?; [ $$rc -eq 75 ] && echo "another scan still holds the lock — skipping this run"; exit $$rc'
SuccessExitStatus=75
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle

# The scanner reads source and writes only to its own state; nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/torana /run/lock
# ⚠️ ProtectHome=read-only would block the CLI's token cache in ~torana/.torana,
# which it must UPDATE on every refresh. Give it that one path back.
# ⛔ This directory MUST EXIST or the unit does not start: systemd fails the mount
# namespace with "status=226/NAMESPACE" before ExecStart runs, naming neither this
# directory nor credentials as the cause. install.sh creates it for exactly this
# reason — if you see 226/NAMESPACE, check that it is there and owned by torana.
ReadWritePaths=/home/torana/.torana
# ⛔ Your checkouts are deliberately NOT here: the scanner only reads them, and a
# scanner that cannot write to source cannot corrupt it. That is also why
# TORANA_GIT_PULL defaults to "false" — with it on, every `git fetch` would fail on
# this read-only filesystem. If you want the scanner to refresh the checkouts, add
# the path with a drop-in (`systemctl edit torana-scan.service`) rather than editing
# this file, which an upgrade overwrites:
#     [Service]
#     ReadWritePaths=/srv/src

[Install]
WantedBy=multi-user.target
