        "entry_coverage": {
          "type": "object",
          "description": "Whether this tree's entry set may be believed COMPLETE, judged against the entry-defining packages the tree DECLARES \u2014 the only form of completeness that can be checked. `answer` already refuses an EMPTY entry set; it cannot refuse a PARTIAL one, which would call a function reachable only through an unenumerated framework's route `no_path_from_entry_point`. Fails closed.",
          "required": [
            "frameworks",
            "not_enumerated",
            "complete",
            "found_in_tree"
          ],
          "properties": {
            "frameworks": {
              "type": "array",
