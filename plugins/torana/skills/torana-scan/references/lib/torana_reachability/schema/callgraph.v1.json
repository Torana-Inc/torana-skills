{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas/index/callgraph.v1",
  "title": "index/callgraph.json — the Python call graph, reach not stored (REACHABILITY_EXTRACTOR.md § 3.3.2.2)",
  "type": "object",
  "required": ["schema", "engine", "commit", "repository", "files", "file_sha", "parse_failures", "languages", "truncated", "records"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "atlas/index/callgraph.v1"},
    "engine": {"type": "string"},
    "commit": {"type": ["string", "null"]},
    "repository": {"type": ["string", "null"]},
    "files": {"type": "array", "items": {"type": "string"}},
    "file_sha": {"type": "array", "items": {"type": "string"}},
    "parse_failures": {"type": "array", "items": {"type": "object", "required": ["file", "reason"],
      "properties": {"file": {"type": "string"}, "reason": {"type": "string"}}}},
    "languages": {"type": "object", "properties": {"python": {"enum": ["parsed", "parser_missing", "absent"]}}},
    "truncated": {"type": "boolean"},
    "records": {"type": "array", "items": {"oneOf": [
      {"type": "object", "required": ["kind", "id", "f", "line", "end_line", "name", "decorators", "async"],
       "properties": {"kind": {"const": "def"}, "id": {"type": "string"}, "f": {"type": "integer", "minimum": 0},
         "line": {"type": "integer"}, "end_line": {"type": "integer"}, "name": {"type": "string"},
         "decorators": {"type": "array", "items": {"type": "string", "maxLength": 200}}, "async": {"type": "boolean"}},
       "additionalProperties": false},
      {"type": "object", "required": ["kind", "def", "entry_kind", "via", "f", "line"],
       "properties": {"kind": {"const": "entry"}, "def": {"type": "string"},
         "entry_kind": {"enum": ["route", "cli", "task", "main"]}, "via": {"type": "string"},
         "f": {"type": "integer", "minimum": 0}, "line": {"type": "integer"}},
       "additionalProperties": false},
      {"type": "object", "required": ["kind", "f", "line", "callee"],
       "properties": {"kind": {"const": "module_call"}, "f": {"type": "integer", "minimum": 0}, "line": {"type": "integer"},
         "callee": {"type": "string"}},
       "additionalProperties": false},
      {"type": "object", "required": ["kind", "from", "callee", "line", "targets", "certain"],
       "properties": {"kind": {"const": "call"}, "from": {"type": "string"}, "callee": {"type": "string"},
         "line": {"type": "integer"}, "targets": {"type": "array", "items": {"type": "string"}}, "certain": {"type": "boolean"}},
       "additionalProperties": false},
      {"type": "object", "required": ["kind", "f", "line", "module", "target_f"],
       "properties": {"kind": {"const": "module_import"}, "f": {"type": "integer", "minimum": 0}, "line": {"type": "integer"},
         "module": {"type": "string"}, "target_f": {"type": ["integer", "null"]}},
       "additionalProperties": false}
    ]}}
  }
}
